# Modelo das variáveis de ambiente. Copie para ".env" e preencha com valores
# REAIS apenas no servidor. NUNCA coloque segredos de verdade neste arquivo: ele
# é versionado no git (há um teste que falha se aparecer um valor que pareça
# segredo aqui).
#
# Gerar um segredo forte:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# ── Banco (PostgreSQL) ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://USUARIO:SENHA@HOST:5432/postgres"
# Limite de conexões abertas por instância do app (padrão do driver: 10).
DB_POOL_MAX=""

# ── Segurança (obrigatórias) ────────────────────────────────────────────────
# Assina a sessão de login. Trocar desloga todo mundo.
SESSION_SECRET="troque-por-um-segredo-aleatorio"
# Criptografa credenciais de conexões (WhatsApp/Instagram/e-mail), chaves de API
# e deriva os tokens dos webhooks. Trocar exige re-criptografar o que já está
# salvo — não troque sem planejar.
CONNECTIONS_SECRET="troque-por-um-segredo-aleatorio"
APP_BASE_URL="https://seu-dominio.exemplo.com"

# ── Webhooks ────────────────────────────────────────────────────────────────
# "true" recusa webhooks sem token. Deixe vazio durante a migração (URLs antigas
# continuam valendo, com aviso no log); ligue depois de usar "Atualizar webhook"
# em Conexões e copiar as novas URLs (com ?token=) para quem chama.
WEBHOOK_REQUIRE_TOKEN=""
# Token de verificação do webhook do Instagram (você define; a Meta devolve).
INSTAGRAM_VERIFY_TOKEN="troque-por-um-token-aleatorio"
# App Secret do app da Meta: com ele o app confere a assinatura de cada evento
# do Instagram. Sem ele qualquer um pode forjar eventos.
INSTAGRAM_APP_SECRET=""

# ── Integrações opcionais ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Fila das automações (nós de "Espera"). Sem Redis cai no modo de segurança.
REDIS_URL="redis://redis:6379"

# ── Só para desenvolvimento ─────────────────────────────────────────────────
# Senha fixa para o seed (sem isso o seed gera senhas aleatórias e as imprime).
SEED_PASSWORD=""
